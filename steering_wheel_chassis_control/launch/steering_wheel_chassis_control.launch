<launch>   

<param name="~wheel_radius" value="0.102"/>  <!-- 实际车轮半径 -->
<param name="~wheel_base" value="0.640"/>    <!-- 实际轮距 -->

 <include file="$(find steering_wheel_chassis)/launch/start.launch"></include>

<node name="test_" pkg="steering_wheel_chassis_control" type="test_" output="screen" />

<!-- <node name="example" pkg="steering_wheel_chassis_control" type="example" output="screen" /> -->
  
<node name="wheel_odometry" pkg="steering_wheel_chassis_control" type="wheel_odometry_node" output="screen" />

<node name="keyboard_teleop" pkg="steering_wheel_chassis_control" type="keyboard_teleop_node" output="screen" />


</launch>   
